{
  "name": "openbell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && forge build",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:risk && npm run test:contracts",
    "test:risk": "vitest run",
    "test:contracts": "forge test",
    "test:fork": "forge test --match-contract OpenBellReceivablesCanonicalUSDGForkTest -vvv",
    "check": "forge fmt --check && npm run typecheck && npm test"
  },
  "dependencies": {
    "viem": "2.55.13",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
